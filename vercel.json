{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/plain.*"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "format",
          "value": "markdown"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "format",
          "value": "md"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "output",
          "value": "markdown"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ChatGPT-User|ClaudeBot|Claude-Web|PerplexityBot|Google-Extended|Gemini|CCBot|CommonCrawl|Firecrawl|LangChain|CrewAI|Anthropic|AnthropicClaude|OpenAI|OAI-SearchBot|Meta-ExternalAgent|Meta-ExternalFetcher|AppleBot|Grok|xAI|Mistral|Cohere|DeepSeek|YouBot|DeepSearch|DeepResearch|BingBot|BingPreview|SemanticScholar|Crossref|DataForSEO|Seobility|Browserbase|AutoGPT|BabyAGI|GPT-Research|Notion.*Bot|Slackbot|Discordbot|TelegramBot|WhatsApp|AhrefsBot|SemrushBot|MJ12bot|DotBot|Seobility).*"
        }
      ],
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/:path*.md",
      "destination": "/ai/:path*.md"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/ai/index.md"
    }
  ],
  "headers": [
    {
      "source": "/ai/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/llms\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=43200"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/ai-sitemap\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=43200"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
