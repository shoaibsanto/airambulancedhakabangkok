# ── Copy these into Vercel → Project → Settings → Environment Variables ──
# Everything works without them; set them to switch features on.

# Conversion tracking (client-side, must be NEXT_PUBLIC_*)
NEXT_PUBLIC_GA_ID=            # Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=           # Google Tag Manager (optional), e.g. GTM-XXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=      # Meta (Facebook) Pixel, e.g. 1234567890

# Lead capture (server-side) — set ANY of these so leads are never lost.
LEAD_WEBHOOK_URL=             # Zapier/Make/Google Apps Script/n8n webhook (recommended)
TELEGRAM_BOT_TOKEN=           # Telegram bot token for instant phone alerts
TELEGRAM_CHAT_ID=             # Telegram chat/group id
RESEND_API_KEY=              # Resend API key for email alerts
LEAD_EMAIL_TO=               # where lead emails go, e.g. info@airambulancedhakabangkok.com
LEAD_EMAIL_FROM=             # verified sender, e.g. leads@airambulancedhakabangkok.com
